{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist-electron",
    "rootDir": "src",
    "esModuleInterop": true,
    "types": ["node", "electron"]
  },
  "include": [
    "src/main.ts",
    "src/preload.ts",
    "src/main/**/*.ts",
    "src/ai/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
