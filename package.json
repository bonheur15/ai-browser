{
  "name": "ai-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Electron browser with isolated Spaces and an optional Codex agent.",
  "author": {
    "name": "Rumanzi Bonheur",
    "email": "bonheur@hubfly.space",
    "url": "https://github.com/bonheur15"
  },
  "license": "UNLICENSED",
  "desktopName": "ai-browser.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonheur15/ai-browser.git"
  },
  "homepage": "https://github.com/bonheur15/ai-browser#readme",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome ci",
    "check:write": "biome check --write",
    "verify": "npm run check && npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "smoke:package:linux": "scripts/smoke-packaged-linux.sh",
    "release:validate": "node scripts/validate-release.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
