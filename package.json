{
  "name": "ai-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal AI browser desktop shell.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE electron . --dev",
    "build": "npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
